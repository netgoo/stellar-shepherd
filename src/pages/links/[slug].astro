---
export async function getStaticPaths() {
  const affiliateLinks = [
    {
      "slug": "make",
      "targetUrl": "https://www.make.com/en/register?pc=alexflow",
      "pageTitle": "Redirecting to Make.com | ALEX AUTOMATION",
      "linkText": "Open Make.com"
    },
    {
      "slug": "clay",
      "targetUrl": "https://clay.com?via=5edfad",
      "pageTitle": "Redirecting to Clay | ALEX AUTOMATION",
      "linkText": "Open Clay"
    },
    {
      "slug": "smartlead",
      "targetUrl": "https://app.smartlead.ai/sign-up/?via=wenboom",
      "pageTitle": "Redirecting to Smartlead | ALEX AUTOMATION",
      "linkText": "Open Smartlead"
    }
  ];
  return affiliateLinks.map(item => ({
    params: { slug: item.slug },
    props: item
  }));
}

const { targetUrl, pageTitle, linkText } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="robots" content="noindex, nofollow"/>
    <meta name="referrer" content="strict-origin-when-cross-origin"/>
    <meta http-equiv="refresh" content={`1;url=${targetUrl}`} />
    <title>{pageTitle}</title>
</head>
<body style="margin:3rem 1.5rem;font-family:system-ui,sans-serif;background:#0B0F19;color:#F3F4F6;text-align:center;">
    <p>Redirecting, please wait...</p>
    <p style="margin-top:1rem;">
        If you are not redirected, click here:
        <a href={targetUrl} rel="noopener noreferrer nofollow" style="color:#F3C653;">{linkText}</a>
    </p>
    <!-- 将url放到dataset，脚本读取，避免script标签内插值失效 -->
    <script data-redirect={targetUrl}>
        const dest = document.currentScript.dataset.redirect;
        window.location.href = dest;
    </script>
</body>
</html>
